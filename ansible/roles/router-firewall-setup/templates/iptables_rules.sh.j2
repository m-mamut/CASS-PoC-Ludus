#!/bin/bash

# Flush existing rules
iptables -F
iptables -t nat -F

# Default policies
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT ACCEPT

# Allow loopback
iptables -A INPUT -i lo -j ACCEPT

# Allow established connections
iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Allow incoming SSH
iptables -A INPUT -p tcp --dport 22 -j ACCEPT

# Allow ICMP (ping)
iptables -A INPUT -p icmp -j ACCEPT

# Forward rules for internal networks
# From network_0 (10.11.1.0/25) to internet
iptables -A FORWARD -s 10.11.1.0/25 -d 0.0.0.0/0 -j ACCEPT
iptables -A FORWARD -d 10.11.1.0/25 -s 0.0.0.0/0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# From network_1 (10.11.1.128/25) to internet
iptables -A FORWARD -s 10.11.1.128/25 -d 0.0.0.0/0 -j ACCEPT
iptables -A FORWARD -d 10.11.1.128/25 -s 0.0.0.0/0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# From network_2 (10.11.2.0/25) to internet
iptables -A FORWARD -s 10.11.2.0/25 -d 0.0.0.0/0 -j ACCEPT
iptables -A FORWARD -d 10.11.2.0/25 -s 0.0.0.0/0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# NAT masquerading for outbound traffic
iptables -t nat -A POSTROUTING -o {{ wan_interface }} -j MASQUERADE  # dynamically detected internet-facing interface

# Allow forwarding between internal networks
iptables -A FORWARD -s 10.11.1.0/25 -d 10.11.1.128/25 -j ACCEPT
iptables -A FORWARD -s 10.11.1.128/25 -d 10.11.1.0/25 -j ACCEPT
iptables -A FORWARD -s 10.11.1.0/25 -d 10.11.2.0/25 -j ACCEPT
iptables -A FORWARD -s 10.11.2.0/25 -d 10.11.1.0/25 -j ACCEPT
iptables -A FORWARD -s 10.11.1.128/25 -d 10.11.2.0/25 -j ACCEPT
iptables -A FORWARD -s 10.11.2.0/25 -d 10.11.1.128/25 -j ACCEPT
